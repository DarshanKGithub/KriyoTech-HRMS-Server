DATABASE_URL=sqlite:///./hrms.db
# Set both keys to long random values before deployment. SECRET_KEY signs JWTs.
SECRET_KEY=replace-with-a-long-random-jwt-secret
DJANGO_SECRET_KEY=replace-with-a-separate-long-random-django-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TIME_ZONE=Asia/Kolkata
# Copy this template to .env.local; that file overrides .env and stays ignored.
PUBLIC_APP_URL=http://localhost:3000
MAIL_TRANSPORT=auto
SMTP_SERVER=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@kriyotechlabs.com
